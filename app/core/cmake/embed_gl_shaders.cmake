# Embed src/gl/shaders/lighting-* and lamp-* into a C++ header of string literals.
# Usage: include() after setting CORE_GL_SHADERS_DIR and CORE_GL_EMBEDDED_SHADERS_H

if(NOT CORE_GL_SHADERS_DIR OR NOT CORE_GL_EMBEDDED_SHADERS_H)
  message(FATAL_ERROR "embed_gl_shaders.cmake: set CORE_GL_SHADERS_DIR and CORE_GL_EMBEDDED_SHADERS_H")
endif()

# AR colors → lighting; lamp-* = point-light marker cube (AR lightCubeShader).
set(_vs "${CORE_GL_SHADERS_DIR}/lighting-vs.vs")
set(_fs "${CORE_GL_SHADERS_DIR}/lighting-fs.fs")
set(_lamp_vs "${CORE_GL_SHADERS_DIR}/lamp-vs.vs")
set(_lamp_fs "${CORE_GL_SHADERS_DIR}/lamp-fs.fs")
if(NOT EXISTS "${_vs}" OR NOT EXISTS "${_fs}")
  message(FATAL_ERROR "Missing lighting shaders under ${CORE_GL_SHADERS_DIR}")
endif()
if(NOT EXISTS "${_lamp_vs}" OR NOT EXISTS "${_lamp_fs}")
  message(FATAL_ERROR "Missing lamp shaders under ${CORE_GL_SHADERS_DIR}")
endif()

file(READ "${_vs}" _vs_src)
file(READ "${_fs}" _fs_src)
file(READ "${_lamp_vs}" _lamp_vs_src)
file(READ "${_lamp_fs}" _lamp_fs_src)

# GLES requires #version on the first line; strip any leading comment preamble.
foreach(_src_var IN ITEMS _vs_src _fs_src _lamp_vs_src _lamp_fs_src)
  string(FIND "${${_src_var}}" "#version" _ver_pos)
  if(_ver_pos LESS 0)
    message(FATAL_ERROR "embed_gl_shaders: ${_src_var} missing #version")
  elseif(_ver_pos GREATER 0)
    string(SUBSTRING "${${_src_var}}" ${_ver_pos} -1 ${_src_var})
  endif()
endforeach()

set(_hdr "// Generated by embed_gl_shaders.cmake — do not edit.\n")
string(APPEND _hdr "#ifndef CORE_GL_EMBEDDED_SHADERS_H_\n")
string(APPEND _hdr "#define CORE_GL_EMBEDDED_SHADERS_H_\n\n")
string(APPEND _hdr "static const char kLightingVertShader[] = R\"GLSL(${_vs_src})GLSL\";\n\n")
string(APPEND _hdr "static const char kLightingFragShader[] = R\"GLSL(${_fs_src})GLSL\";\n\n")
string(APPEND _hdr "static const char kLampVertShader[] = R\"GLSL(${_lamp_vs_src})GLSL\";\n\n")
string(APPEND _hdr "static const char kLampFragShader[] = R\"GLSL(${_lamp_fs_src})GLSL\";\n\n")
string(APPEND _hdr "#endif /* CORE_GL_EMBEDDED_SHADERS_H_ */\n")

file(WRITE "${CORE_GL_EMBEDDED_SHADERS_H}" "${_hdr}")
