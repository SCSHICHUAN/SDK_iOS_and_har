# Minimal iOS toolchain for building core.a
# Usage:
#   cmake -B build-ios -S . \
#     -DCMAKE_TOOLCHAIN_FILE=cmake/toolchains/ios.toolchain.cmake \
#     -DCORE_IOS_PLATFORM=OS64
#
# CORE_IOS_PLATFORM: OS64 | SIMULATOR64 | SIMULATORARM64

set(CMAKE_SYSTEM_NAME iOS)
set(CMAKE_SYSTEM_VERSION 12.0)

if(NOT DEFINED CORE_IOS_PLATFORM)
  set(CORE_IOS_PLATFORM "OS64")
endif()

if(CORE_IOS_PLATFORM STREQUAL "OS64")
  set(CMAKE_OSX_ARCHITECTURES "arm64")
  set(CMAKE_OSX_SYSROOT "iphoneos")
elseif(CORE_IOS_PLATFORM STREQUAL "SIMULATOR64")
  set(CMAKE_OSX_ARCHITECTURES "x86_64")
  set(CMAKE_OSX_SYSROOT "iphonesimulator")
elseif(CORE_IOS_PLATFORM STREQUAL "SIMULATORARM64")
  set(CMAKE_OSX_ARCHITECTURES "arm64")
  set(CMAKE_OSX_SYSROOT "iphonesimulator")
else()
  message(FATAL_ERROR "Unknown CORE_IOS_PLATFORM=${CORE_IOS_PLATFORM}")
endif()

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
